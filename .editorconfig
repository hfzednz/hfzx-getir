# NEXORA monorepo — editor defaults (do not reformat generated protos/OpenAPI by hand in IDEs without team agreement)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_size = 4

[*.{dart,kt,kts,swift}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
