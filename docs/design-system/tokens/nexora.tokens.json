      "button.md": { "size": 14, "lineHeight": 20, "weight": 600, "tracking": 0, "family": "body" },
      "button.sm": { "size": 13, "lineHeight": 18, "weight": 600, "tracking": 0, "family": "body" },
      "nav.md": { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0, "family": "body" },
