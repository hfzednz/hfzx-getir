  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Orders / min",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexora_orders_placed_total[1m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "GMV minor / min",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nexora_gmv_minor_total[1m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Authorize success ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(nexora_payment_authorize_total{result=\"success\"}[5m])) / sum(rate(nexora_payment_authorize_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ETA breach rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(nexora_eta_breach_total[5m])) / sum(rate(nexora_orders_delivered_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
