{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "security.ThreatDetected.v1",
  "type": "object",
  "required": ["type", "aggregateId", "tenantId", "occurredAt"],
  "properties": {
    "type": { "const": "ThreatDetected" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "kind": { "type": "string" },
    "severity": { "type": "string" },
    "score": { "type": "number" },
    "subject": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
